ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://navya:navya@localhost:5433/navya
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
# Local Expo/browser origins. Production Expo clients are native and do not
# require CORS; add any browser frontend origins here when applicable.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Production example (keep this only in Render's secret environment variables):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/navya?sslmode=require
